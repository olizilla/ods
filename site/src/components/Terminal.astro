---
// Body text is hardcoded terminal output (site/src/data/terminal/*.txt, imported with
// ?raw), coloured here by simple line shape rather than the design's per-character spans:
// a `❯` prompt line, a `#`/`*` comment line, a pure box-drawing border, or a row that mixes
// box-drawing separators with cell text.
import {
  colourDuckdbCommand,
  colourQuoted,
  colourSql,
  markRoleCodes,
  type Kind,
  type Segment,
} from '../lib/syntax';

interface Props {
  label?: string;
  content: string;
  // The lines that aren't prompts, comments or tables are SQL, so their syntax recedes.
  sql?: boolean;
}

const { label = 'Shell', content, sql = false } = Astro.props;

const BOX_CHAR = /[┌┬┐│┆╞═╪╡├┴┤└─┘]/;
const BOX_RUN = /([┌┬┐│┆╞═╪╡├┴┤└─┘]+)/;
// `ods cite`'s own sub-headers: short, no trailing punctuation but a colon, or a bare title.
const SUB_HEADER = /^\s*(The source|The data|The tool):\s*$/;
const BARE_HEADER = /^(How to Cite|Data availability)$/;
// An ODS code is a letter then letters/digits, at least one digit; RO-codes are roles, not orgs.
const ODS_CODE = /^(?=.*\d)[A-Z][A-Z0-9]{2,8}$/;
const ODS_INFO = /^❯( ods info )(\S+)(.*)$/;

// The first cell of a table row is the ODS code when it looks like one, keeping its padding.
function markOdsCode(parts: Segment[]): Segment[] {
  const first = parts.findIndex((p) => p.kind === 'ink');
  if (first === -1) return parts;
  const cell = parts[first].text;
  const code = cell.trim();
  if (!ODS_CODE.test(code) || /^RO\d+$/.test(code)) return parts;
  const start = cell.indexOf(code);
  return [
    ...parts.slice(0, first),
    { text: cell.slice(0, start), kind: 'ink' as Kind },
    { text: code, kind: 'accent' as Kind },
    { text: cell.slice(start + code.length), kind: 'ink' as Kind },
    ...parts.slice(first + 1),
  ];
}

function classifyLine(line: string): Segment[] {
  if (line.startsWith('❯ duckdb -c "')) {
    return [
      { text: '❯', kind: 'accent' },
      { text: ' ', kind: 'ink' },
      ...colourDuckdbCommand([line.slice(2)])[0],
    ];
  }
  if (line.startsWith('❯')) {
    const info = line.match(ODS_INFO);
    if (info) {
      return [
        { text: '❯', kind: 'accent' },
        { text: info[1], kind: 'ink' },
        { text: info[2], kind: 'accent' },
        { text: info[3], kind: 'ink' },
      ];
    }
    return [
      { text: '❯', kind: 'accent' },
      { text: line.slice(1), kind: 'ink' },
    ];
  }
  if (line.startsWith('#') || line.startsWith('*')) {
    return [{ text: line, kind: 'dim' }];
  }
  if (SUB_HEADER.test(line) || BARE_HEADER.test(line)) {
    return [{ text: line, kind: 'header' }];
  }
  const stripped = line.replace(/\s/g, '');
  if (stripped.length > 0 && [...stripped].every((c) => BOX_CHAR.test(c))) {
    return [{ text: line, kind: 'frame' }];
  }
  if (BOX_CHAR.test(line)) {
    return markOdsCode(
      line
        .split(BOX_RUN)
        .filter((part) => part.length > 0)
        .map((part) => ({ text: part, kind: (BOX_CHAR.test(part) ? 'frame' : 'ink') as Kind })),
    );
  }
  return sql ? colourSql(line) : colourQuoted(line, 'ink', 'dim');
}

const lines = content.replace(/\n$/, '').split('\n').map((line) => markRoleCodes(classifyLine(line)));
---

<div class="terminal">
  <div class="chrome">
    <span class="chrome-label">{label}</span>
  </div>
  <div class="body">
    {lines.map((segments) => (
      <div class="line">
        {segments.map((seg) => <span class={`seg-${seg.kind}`}>{seg.text}</span>)}
      </div>
    ))}
  </div>
</div>

<style>
  .terminal {
    font-family: var(--font-mono);
  }
  .chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 7px 8px 7px 16px;
    background: var(--term-chrome);
    border: 1px solid var(--term-edge);
    border-bottom: none;
  }
  .chrome-label {
    font-size: 12.5px;
    color: var(--term-label);
  }
  .body {
    background: var(--term-bg);
    border: 1px solid var(--term-edge);
    padding: 18px 22px;
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.65;
  }
  .line {
    white-space: pre;
    min-height: 1lh;
  }
  @media (max-width: 800px) {
    .terminal {
      margin-inline: calc(var(--gutter) * -1);
    }
    .chrome,
    .body {
      border-inline: none;
    }
    .chrome {
      padding-left: 8px;
    }
    .body {
      padding-inline: 8px 16px;
      font-size: 12px;
    }
  }
  .seg-ink {
    color: var(--term-ink);
  }
  .seg-dim {
    color: var(--term-dim);
  }
  .seg-accent {
    color: var(--term-accent);
  }
  .seg-role {
    color: var(--term-role);
  }
  .seg-frame {
    color: var(--term-frame);
  }
  .seg-header {
    color: var(--term-mid);
    font-weight: 600;
  }
</style>
