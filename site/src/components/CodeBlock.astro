---
// A dark code box under a Terminal-style label strip, for a duckdb SQL command or JSON.
// Colouring is line/token-based rather than a full parser: keywords and JSON keys in accent;
// in SQL the syntax recedes and quoted literals stand out, in JSON it's the other way round.
import { colourDuckdbCommand, colourQuoted, markRoleCodes, type Segment } from '../lib/syntax';

interface Props {
  content: string;
  label: string;
  lang: 'sql' | 'json';
}

const { content, label, lang } = Astro.props;

const JSON_KEY = /^(\s*)("[^"]+")(:)/;

function classifyJsonLine(line: string): Segment[] {
  const jsonKeyMatch = line.match(JSON_KEY);
  if (jsonKeyMatch) {
    const [, indent, key, colon] = jsonKeyMatch;
    const rest = line.slice(indent.length + key.length + colon.length);
    return [
      { text: indent, kind: 'ink' },
      { text: key, kind: 'accent' },
      { text: colon, kind: 'ink' },
      { text: rest, kind: 'ink' },
    ];
  }
  return colourQuoted(line, 'ink', 'dim');
}

const rawLines = content.replace(/\n$/, '').split('\n');
const lines = (lang === 'sql' ? colourDuckdbCommand(rawLines) : rawLines.map(classifyJsonLine)).map(
  markRoleCodes,
);
---

<div class="codeblock">
  <div class="chrome">
    <span class="chrome-label">{label}</span>
  </div>
  <div class="code">
    {lines.map((segments) => (
      <div class="line">
        {segments.map((seg) => <span class={`seg-${seg.kind}`}>{seg.text}</span>)}
      </div>
    ))}
  </div>
</div>

<style>
  .chrome {
    display: flex;
    align-items: center;
    padding: 7px 8px 7px 16px;
    background: var(--term-chrome);
    border: 1px solid var(--term-edge);
    border-bottom: none;
    font-family: var(--font-mono);
  }
  .chrome-label {
    font-size: 12.5px;
    color: var(--term-label);
  }
  .code {
    background: var(--term-bg);
    border: 1px solid var(--term-edge);
    padding: 18px 22px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
  }
  .line {
    white-space: pre;
  }
  @media (max-width: 800px) {
    .codeblock {
      margin-inline: calc(var(--gutter) * -1);
    }
    .chrome,
    .code {
      border-inline: none;
    }
    .code {
      padding-inline: 16px;
      font-size: 12px;
    }
  }
  .seg-ink {
    color: var(--term-ink);
  }
  .seg-dim {
    color: var(--term-dim);
  }
  .seg-accent {
    color: var(--term-accent);
  }
  .seg-role {
    color: var(--term-role);
  }
</style>
