---
import { formatCount, formatMB } from '../lib/format';

interface Props {
  date: string;
  totalSizeBytes: number;
  orgsRecordCount: number;
}

const { date, totalSizeBytes, orgsRecordCount } = Astro.props;
---

<div class="meta">
  <div class="line">Release <span class="date">{date}</span></div>
  <div class="facts">
    <span class="records">{formatCount(orgsRecordCount)} records · </span>{formatMB(totalSizeBytes)} · <abbr title="Open Government Licence v3.0">OGL v3</abbr>
  </div>
</div>

<style>
  .meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    padding: 28px 0 0;
    margin-bottom: 16px;
    font-family: var(--font-sans);
  }
  .line {
    min-width: 0;
    font-size: 15px;
    color: var(--ink-secondary);
  }
  .facts {
    min-width: 0;
    font-size: 14px;
    color: var(--ink-muted);
  }
  abbr {
    text-decoration: none;
  }
  @media (max-width: 500px) {
    .records {
      display: none;
    }
  }
  .date {
    font-weight: 700;
    color: var(--ink);
  }
</style>
