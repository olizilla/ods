---
const brewCmd = 'brew install olizilla/tap/ods'
const command = 'cargo install --locked --git https://github.com/olizilla/ods.git';
---

<div id="install" class="panel">
  <div class="heading-row">
    <h3>Install ods</h3>
    <span class="platforms">macOS & Linux</span>
  </div>
  <p>Use Homebrew. It packs things into OCI Images too!</p>
  <div class="command-row">
    <div class="command"><span class="prompt">❯ </span>{brewCmd}</div>
    <button type="button" class="copy" data-command={brewCmd}>Copy</button>
  </div>
  <p class="source">Or install from source with <code>{command}</code></p>
  <p>
    Need <code>ods</code> on windows? <a href="https://github.com/olizilla/ods/issues">Open an issue</a>
  </p>
</div>

<style>
  .source code{
    user-select: all;
    display: block;
    padding-top: 16px;
  }
  .panel {
    background: var(--panel);
    border-top: 4px solid var(--blue);
    padding: 28px 28px 26px;
    margin-bottom: 56px;
    font-family: var(--font-sans);
  }
  .heading-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }
  h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    color: var(--ink);
  }
  .platforms {
    font-size: 14px;
    color: var(--ink-muted);
  }
  .note {
    margin: 0 0 18px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink);
    max-width: 62ch;
  }
  .note code {
    font-family: var(--font-mono);
    font-size: 13.5px;
    color: var(--ink);
  }
  .command-row {
    display: flex;
    align-items: stretch;
    background: var(--term-bg);
    border: 1px solid var(--term-edge);
    margin-bottom: 14px;
  }
  .command {
    flex: 1 1 auto;
    min-width: 0;
    padding: 16px 20px;
    overflow-x: auto;
    white-space: pre;
    font-family: var(--font-mono);
    font-size: 14.5px;
    color: var(--term-ink);
    user-select: all;
  }
  .prompt {
    color: var(--term-accent);
    user-select: none;
  }
  @media (max-width: 800px) {
    .source{
      display: none;
    }
    .panel {
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: 16px;
    }
    .command-row {
      margin-inline: -16px;
      border-inline: none;
    }
    .command {
      padding-inline: 16px;
    }
  }
  @media (max-width: 600px) {
    .command {
      font-size: 12px;
    }
  }
  .copy {
    flex: none;
    border: none;
    cursor: pointer;
    background: var(--green);
    color: var(--white);
    font: 600 15px var(--font-sans);
    padding: 0 22px;
    box-shadow: inset 0 -4px 0 var(--green-shadow);
  }
  @media (max-width: 800px) {
    .copy {
      display: none;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.copy[data-command]');
  for (const button of buttons) {
    let timeoutId: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener('click', async () => {
      const command = button.dataset.command ?? '';
      try {
        await navigator.clipboard.writeText(command);
      } catch {
        // clipboard access denied or unavailable; the button still shows the command
      }
      button.textContent = 'Copied';
      clearTimeout(timeoutId);
      timeoutId = setTimeout(() => {
        button.textContent = 'Copy';
      }, 1600);
    });
  }
</script>
