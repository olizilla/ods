      "name": "orgs",
      "type": "table",
      "path": "orgs.parquet",
      "format": "parquet",
      "mediatype": "application/vnd.apache.parquet",
      "schema": {
        "fields": [
          {
            "name": "ods_code",
            "type": "string",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "name",
            "type": "string",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "status",
            "type": "string",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "record_class",
            "type": "string",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "role_codes",
            "type": "list",
            "itemType": "string",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "role_names",
            "type": "list",
            "itemType": "string",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "primary_role_code",
            "type": "string",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "address",
            "type": "string"
