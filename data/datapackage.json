            }
          },
          {
            "name": "legal_start",
            "type": "date"
          },
          {
            "name": "legal_end",
            "type": "date"
          },
          {
            "name": "operational_start",
            "type": "date"
          },
          {
            "name": "operational_end",
            "type": "date"
          },
          {
            "name": "role_id",
            "type": "string",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "publication_date",
            "type": "date",
            "constraints": {
              "required": true
