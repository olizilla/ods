            "type": "string",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "rel_name",
            "type": "string",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "rel_status",
            "type": "string",
            "constraints": {
              "required": true
