          {
            "name": "town",
            "type": "string"
          },
          {
            "name": "county",
            "type": "string"
          },
          {
            "name": "postcode",
            "type": "string"
          },
          {
            "name": "country",
            "type": "string"
          },
          {
            "name": "uprn",
            "type": "string"
          },
          {
            "name": "telephone",
            "type": "string"
          },
          {
            "name": "website",
            "type": "string"
          },
          {
            "name": "predecessor_codes",
            "type": "list",
            "itemType": "string",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "successor_codes",
            "type": "list",
            "itemType": "string",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "legal_start",
            "type": "date"
          },
          {
            "name": "legal_end",
            "type": "date"
          },
          {
            "name": "operational_start",
            "type": "date"
          },
          {
            "name": "operational_end",
            "type": "date"
          },
          {
            "name": "last_changed",
            "type": "date"
          },
          {
            "name": "publication_date",
            "type": "date",
            "constraints": {
              "required": true
            }
          }
        ],
        "primaryKey": [
          "ods_code"
        ]
      }
    },
    {
      "name": "roles",
      "type": "table",
      "path": "roles.parquet",
