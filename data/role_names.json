  "_type": "ods_role_names",
  "version": 1,
  "policy": [
    "Curated display names for the ODS OrganisationRole vocabulary.",
    "The source publishes these in upper case, occasionally abbreviated or misspelled.",
    "Most entries below are mechanical case normalisation and need no justification.",
    "Entries listed in `rewrites` change more than case; each records why.",
    "Acronyms: terse by default. Use the form a practitioner would say, and expand",
    "only when the acronym is not in common currency. Test: would it appear",
    "unexplained in an NHS England publication? ICB, PCN, CCG, GP, NHS pass;",
    "EPACT and DMIC do not."
  ],
  "rewrites": {
    "RO15": "Source reads REG'D UNDER PART 2 CARE STDS ACT 2000. Expanded; the abbreviations are not standard usage.",
    "RO31": "Source reads PPA EPACT SYSTEM. The PPA (Prescription Pricing Authority) was abolished and folded into NHS BSA; ePACT is the surviving system name.",
    "RO87": "Source reads WALK IN CENTRE. Hyphenated to the standard NHS form.",
    "RO158": "Source reads NON STATUTORY. Hyphenated for consistency with RO157 NON-NHS ORGANISATION.",
    "RO176": "Source reads INDEPENDENT SECTOR H/C PROVIDER SITE. Expanded h/c to healthcare, matching RO172 which spells it out in full.",
    "RO215": "Source misspells MANAGEMENT as MANAGMENT. Corrected. If upstream fixes this, the divergence has closed.",
    "RO229": "Source reads NON RESIDENTIAL. Hyphenated for consistency with RO287 NON-MAINTAINED SPECIAL SCHOOL.",
    "RO258": "Source is truncated at 50 characters: SEXUAL ASSAULT REFERRAL CENTRE PRESCRIBING COST CE. Completed to match every other entry in the prescribing cost centre family.",
    "RO300": "Source reads SPECIAL POST 16 INSTITUTION. Hyphenated to the standard Post-16 form.",
    "RO312": "Source reads ACADEMY 16-19 CONVERTER while its sibling RO313 reads ACADEMY 16 TO 19 SPONSOR LED. Normalised to the 16 to 19 form used everywhere else."
  },
